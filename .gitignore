# Only the authored project and selected docs/tools belong in this repository.
/*
!/.gitignore
!/README.md
!/CMakeLists.txt
!/CMakePresets.json
!/src/
/src/**
!/src/**/
!/src/**/*.cpp
!/src/**/*.h
!/tests/
/tests/*
!/tests/*.cpp
!/tests/test_*.py
!/tests/tsan.supp
!/tests/fixtures/
/tests/fixtures/*
!/tests/fixtures/README.md
!/tests/fixtures/synthetic-tone.mp3
!/docs/
/docs/*
!/docs/BUILD.md
!/docs/STATUS.md
!/docs/REFERENCES.md
!/tools/
/tools/*
!/tools/actual_vst3_host.cpp
!/tools/check_vst3_midi_output.py
!/tools/check_vst3_panic.py
!/tools/extract_factory_samples.cpp
!/tools/extract_factory_impulses.py
!/tools/measure_effect_parity.py
!/tools/migrate_factory_content.py
!/tools/modal_effect_parity_verdict.py
!/tools/run_editor_tests.py
!/tools/run_standalone_settings_test.py
!/tools/modal_audit.py
!/tools/modal_mp3_fixture.py

# Only the authored manual CI workflow is exported.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/linux-validation.yml
